# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex
GOOGLE_GENAI_USE_VERTEXAI=1

# ML Dev backend config. Fill if using Ml Dev backend.
GOOGLE_API_KEY=YOUR_VALUE_HERE

# Vertex backend config # Host project for Gemini call
GOOGLE_CLOUD_PROJECT='hbl-gcp-prod-finops-prj-spk-d1'
GOOGLE_CLOUD_LOCATION='asia-south1'

# SQLGen method 
NL2SQL_METHOD="BASELINE" # BASELINE or CHASE

# Set up DataBase Agent 1 - GCP
BQ_PROJECT_ID='hbl-srs-logging-prj-spk-3c'
BQ_DATASET_ID='hbl_gcp_dataset_billing_export_india'

# Set up DataBase Agent 2 - AWS , Azure
BQ_PROJECT_ID2='hbl-gcp-prod-finops-prj-spk-d1'
BQ_DATASET_ID2='multicloud_billing_finops_agent'

# Models used in Agents 
ROOT_AGENT_MODEL='gemini-2.5-flash'
ANALYTICS_AGENT_MODEL='gemini-2.5-flash'
